{
  "profiles": [
    {
      "name": "glm",
      "description": "z.ai GLM (Anthropic-compatible)",
      "baseUrl": "https://api.z.ai/api/anthropic",
      "authToken": "YOUR_ZAI_API_KEY",
      "models": {
        "opus": "GLM-4.7",
        "sonnet": "GLM-4.7",
        "haiku": "GLM-4.5-Air"
      },
      "env": {
        "API_TIMEOUT_MS": "3000000"
      }
    },
    {
      "name": "kimi",
      "description": "Moonshot Kimi K2.5 (Anthropic-compatible)",
      "baseUrl": "https://api.moonshot.ai/anthropic",
      "authToken": "YOUR_MOONSHOT_API_KEY",
      "models": {
        "opus": "kimi-k2.5",
        "sonnet": "kimi-k2.5",
        "haiku": "kimi-k2.5"
      }
    },
    {
      "name": "DeepSeek",
      "description": "DeepSeek V4 (Anthropic-compatible)",
      "baseUrl": "https://api.deepseek.com/anthropic",
      "apiKey": "sk-YOUR_DEEPSEEK_KEY",
      "models": {
        "opus": "deepseek-v4-pro",
        "sonnet": "deepseek-v4-pro",
        "haiku": "deepseek-v4-flash"
      }
    },
    {
      "name": "MiniMax",
      "description": "MiniMax M2 series (Anthropic-compatible)",
      "baseUrl": "https://api.minimax.io/anthropic",
      "apiKey": "YOUR_MINIMAX_API_KEY",
      "models": {
        "opus": "MiniMax-M2.7",
        "sonnet": "MiniMax-M2.5",
        "haiku": "MiniMax-M2.1-highspeed"
      }
    },
    {
      "name": "OpenRouter",
      "description": "OpenRouter multi-model gateway — search and pick models from the server when adding",
      "baseUrl": "https://openrouter.ai/api",
      "apiKey": "sk-or-YOUR_KEY_HERE",
      "models": {
        "opus": "",
        "sonnet": "",
        "haiku": ""
      }
    },
    {
      "name": "LM Studio (local)",
      "description": "Local LM Studio server — replace model IDs with the identifiers loaded in LM Studio",
      "baseUrl": "http://localhost:1234",
      "authToken": "lmstudio",
      "models": {
        "opus": "ibm/granite-4-micro",
        "sonnet": "ibm/granite-4-micro",
        "haiku": "ibm/granite-4-micro"
      }
    },
    {
      "name": "lightning-mlx (local)",
      "description": "Lightning-MLX local server (Apple Silicon) — ccx runs a local OpenAI Chat Completions translation proxy and forwards to /v1/chat/completions. Replace model ID with the identifier reported by /v1/models (default: `local`). Append `[200k]` / `[1m]` to advertise the context window to Claude Code (suffix is stripped before forwarding upstream).",
      "auth": "openai-chat",
      "baseUrl": "http://127.0.0.1:8010",
      "authToken": "lightning-mlx",
      "models": {
        "opus": "local[200k]",
        "sonnet": "local[200k]",
        "haiku": "local[200k]"
      }
    },
    {
      "name": "Codex",
      "description": "Route Codex via your ChatGPT Plus/Pro subscription — run `ccx codex login` first",
      "auth": "codex-oauth",
      "models": {
        "opus": "gpt-5.6-sol[1m]",
        "sonnet": "gpt-5.6-terra[1m]",
        "haiku": "gpt-5.6-luna"
      },
      "env": {
        "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "272000"
      }
    }
  ]
}
